--[[
  Sliding doors on the server. Each part with the tag `Door` and a
  ProximityPrompt in it gets a machine. A push opens the door, it stays
  open for four seconds, then it closes. One Heartbeat moves the clocks
  of all the doors.
]]

import CollectionService from '@game/CollectionService'
import RunService from '@game/RunService'
import { door, type DoorMachine } from './Door'

const doors: DoorMachine[] = []

for _, part in CollectionService:GetTagged('Door') where part is BasePart do
  if const prompt = part:FindFirstChildOfClass('ProximityPrompt') then
    doors:push(door(part, prompt))
  end
end

RunService.Heartbeat:Connect(function(dt)
  for _, machine in doors do
    machine:update(dt)
  end
end)
