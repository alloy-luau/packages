--[[
  Decree: typed console commands for Roblox games. This module sends out
  the public API; each part lives in its own module beside it.

  - args: fail, @argument, and the parse of each argument
  - command: @command, on, level_of, entries
  - net: serve, execute, run, list
]]

export { fail, argument } from './args'
export { command, on, level_of, entries, type Entry, type Reply } from './command'
export { serve, execute, run, list } from './net'
