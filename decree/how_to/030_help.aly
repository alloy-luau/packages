--[[
  Help. Every player may run `help`. With no word it lists the commands
  that the player may run, each with its usage and its line of help.
  With a command's name it shows how to write that command, and what
  each argument wants. Decree writes both from the declarations, so the
  help is never out of date.
]]

import Players from '@game/Players'
import ServerStorage from '@game/ServerStorage'
import { command, entries, execute, fail, on } from '@packages/decree'

--- Gives a player some copies of a tool from ServerStorage.Tools.
@command(0, 'Gives a player copies of a tool.')
remote function Give(target: Player, tool: string, @u8 count: number = 1) -> string from client

--- Counts the commands that the caller may run.
@command(0, 'Counts the commands you may run.')
remote function Commands() -> string from client

on(Give)(function(_, target, tool, count)
  const tools = ServerStorage->Tools ?? fail('The game has no ServerStorage.Tools.')
  const template = tools:FindFirstChild(tool)
  const backpack = target:FindFirstChildOfClass('Backpack')
    ?? fail(`{target.Name} has no backpack.`)

  if template is not Tool then
    return fail(`No tool is called "{tool}".`)
  end

  for _ = 1, count do
    template:Clone().Parent = backpack
  end

  return `Gave {target.Name} {count} {tool}.`
end)

-- `entries` gives the commands a player may run, by name, on the
-- server. A client gets the same list from `list`.
on(Commands)(function(caller)
  const names: { string } = []

  for _, entry in entries(caller) do
    table.insert(names, entry.name)
  end

  return `You may run {#names} commands: {table.concat(names, ', ')}.`
end)

-- `execute` runs a line as a player on the server, as a client's line
-- runs. A server hook, such as a chat command, calls it. Here each
-- player's help goes to the server's output as they join.
Players.PlayerAdded:Connect(function(player)
  print(execute(player, 'help').text)
end)

--[[
  What a player reads:

    help
      Commands you may run:
        commands: Counts the commands you may run.
        give <target> <tool> [count]: Gives a player copies of a tool.
        help [command]: Lists the commands you may run, or shows how to write one.

    help give
      give <target> <tool> [count]
      Gives a player copies of a tool.
        target: a player: a name, the start of one, a display name, or me
        tool: a word, or words in double quotes
        count: a whole number from 0 to 255; 1 when left out

  The rules:

  - `<name>` is an argument that a line must give, and `[name]` one that
    it may leave out.
  - The help of a command is the second argument of `@command`. Keep it
    to one line.
  - A player who asks for a command they may not run reads that no such
    command exists.
]]
