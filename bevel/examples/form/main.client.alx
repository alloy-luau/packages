--[[
  Two forms on one screen. Each provides its own FormState, so the text
  of one does not show in the other.
]]

import Players from '@game/Players'
import { bootstrap, component, create, mount } from '@packages/bevel'
import Form from './Form'

struct AppComponent
end

@component
impl AppComponent
  function new(_props: {}) -> AppComponent
    return new AppComponent {}
  end

  function template(self) -> Instance
    return (
      <ScreenGui>
        <Frame Size={UDim2.fromScale(1, 1)} BackgroundTransparency={1}>
          <UIListLayout />
          <Form title="Sign up" />
          <Form title="Invite a friend" />
        </Frame>
      </ScreenGui>
    )
  end
end

bootstrap(mount(AppComponent), Players.LocalPlayer->'PlayerGui'!)
