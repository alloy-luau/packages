--[[
  Services and injectors. A service is a struct marked `@injectable`.
  `inject(Class)` reads the nearest `provide` that holds the class, then
  the root injector. Each `provide` is an owner, so the lookup walks up
  the owners, as Angular's element injectors walk up the tree.
]]

import { Attributes } from '@alloy/std/roblox'
import { current_owner, new_owner, on_destroy, run_in } from './reactive'

--- Marks a service. The contract asks for `new()` with no parameters,
--- because the injector calls it. `scope = 'root'` lets the root
--- injector build it; any other scope needs a `provide` above it.
export attribute injectable(scope: string = 'root') on struct as
  requires public function new()
end

-- The root injector: one instance for each service class.
local instances: { [unknown]: unknown } = {}

-- The hook that a service may write: Angular's `ngOnDestroy`.
type Hooks = { on_destroy: ((unknown) -> ())? }

--- Angular's `inject()`. The instance that the nearest `provide` holds,
--- or else the one root instance, built on the first call.
export function inject<T>(class: { new: () -> T }) -> T
  local owner = current_owner()

  while owner ~= nil do
    const services = owner.services

    if services ~= nil and services[class] ~= nil then
      return services[class] :: T
    end

    owner = owner.parent
  end

  const scope = Attributes.get(class, injectable)
  assert(scope ~= nil, 'inject(): this class is not marked @injectable')
  assert(scope == 'root', `inject(): this class has scope '{scope}', and no provide() holds it`)

  const existing = instances[class]

  if existing ~= nil then
    return existing :: T
  end

  const instance = class.new()
  instances[class] = instance
  return instance
end

--- Angular's `providers: [...]`. It builds a new instance of each class,
--- then runs `build`. Each `inject` in what `build` makes reads those
--- instances first. A service that writes `on_destroy` hears when the
--- provide goes. The list is `{ any }`: Luau tables are invariant, so a
--- typed list of classes would refuse `[ TodoStore ]`.
export function provide<T>(classes: { any }, build: () -> T) -> T
  local owner = new_owner(current_owner())
  local services: { [unknown]: unknown } = {}
  owner.services = services

  return run_in(owner, function()
    for _, class in classes do
      const service = class.new()
      const destroyed = ((class :: unknown) :: Hooks).on_destroy

      services[class] = service

      if destroyed ~= nil then
        on_destroy(function() destroyed(service) end)
      end
    end

    return build()
  end)
end

@test
namespace InjectTests
  @injectable
  struct Counter
    count: number = 0
  end

  impl Counter
    function new() -> Counter
      return new Counter {}
    end
  end

  @injectable('form')
  struct Draft
    text: string = ''
  end

  impl Draft
    function new() -> Draft
      return new Draft {}
    end
  end

  --- The root injector builds a service once.
  public function inject_builds_one_root_instance() -> ()
    $assert_eq(inject(Counter), inject(Counter))
  end

  --- A class with no @injectable has no injector.
  public function inject_refuses_a_class_that_is_not_injectable() -> ()
    const plain = { new = function() return {} end }

    $expect(function() -> ()
      inject(plain)
    end):toThrow('not marked @injectable')
  end

  --- A service outside the root scope needs a provide.
  public function inject_refuses_a_scoped_class_with_no_provider() -> ()
    $expect(function() -> ()
      inject(Draft)
    end):toThrow('no provide')
  end

  --- A provide holds its own instance, and the root keeps its own.
  public function provide_gives_its_own_instance_inside() -> ()
    const outer = inject(Counter)
    const inner = provide([ Counter ], function() return inject(Counter) end)

    $assert(inner ~= outer)
    $assert_eq(inject(Counter), outer)
  end

  --- An inner provide reads the services of the provide above it.
  public function a_nested_provide_reads_the_services_above_it() -> ()
    const same = provide([ Draft ], function()
      const draft = inject(Draft)
      return provide([ Counter ], function() return inject(Draft) == draft end)
    end)

    $assert(same)
  end
end
