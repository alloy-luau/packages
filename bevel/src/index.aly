--[[
  Bevel: components, services, and signals for Alloy, after Angular.
  This module sends out the public API; each part lives in its own
  module beside it.

  - reactive: signal, computed, effect, untracked, batch, root, on_destroy
  - template: create, each, when, model
  - component: @component, mount, bootstrap
  - inject: @injectable, inject, provide
  - animate: spring, tween, lerp, Easing, Springs
  - async: deferred, resource, interval
  - frame: step, manual_frames
]]

export {
  signal,
  computed,
  effect,
  untracked,
  batch,
  root,
  on_destroy,
  read,
  type Signal,
  type WritableSignal,
  type Readable,
  type EffectRef,
  type OnCleanup,
} from './reactive'
export { create, each, when, model, type Directive, type Model } from './template'
export { component, mount, bootstrap } from './component'
export { injectable, inject, provide } from './inject'
export {
  spring,
  tween,
  lerp,
  Easing,
  Springs,
  type Spring,
  type SpringOptions,
  type TweenOptions,
} from './animate'
export { deferred, resource, interval, type Resource, type ResourceStatus } from './async'
export { step, manual_frames } from './frame'
