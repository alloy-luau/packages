--- The options of a tween: `duration` in seconds, 0.25 by default; the
--- `easing` curve, `Easing.ease_in_out` by default; and a `delay` before
--- it starts.
export type TweenOptions = { duration: number?, easing: Easing?, delay: number? }

--- A value that moves to its target along a curve: what
--- `new Tween(value)` and `Tween.of(fn)` give. `current` is the value
--- now; write `target` to move it.
--- @type Tween { read current: T, read value: T, target: T }
export type Tween<T> = {
  read current: T,
  read value: T,
  target: T,
  set: (self: Tween<T>, value: T, options: SetOptions?) -> (),
}

-- The state of one tween.
type Tweening = {
  output: State<unknown>,
  target: State<unknown>,
  options: TweenOptions,
  -- The options of the next move, from `set`.
  next: SetOptions?,
  job: Job?,
}

type TweenObject = { __svelte_tween: Tweening }

-- Starts a move from the value now to `goal`.
local function move(t: Tweening, goal: unknown) -> ()
  const given: SetOptions = t.next ?? {}
  t.next = nil

  if t.job ~= nil then
    stop(t.job)
    t.job = nil
  end

  const from = t.output.value

  if from == goal then
    return
  end

  const duration = math.max(given.duration ?? t.options.duration ?? 0.25, 1e-6)
  const ease = given.easing ?? t.options.easing ?? Easing.ease_in_out
  local elapsed = -(given.delay ?? t.options.delay ?? 0)

  const job = function(dt: number) -> boolean
    elapsed += dt

    const p = math.clamp(elapsed / duration, 0, 1)
    t.output.value = lerp(from, goal, ease(p))

    if p >= 1 then
      t.job = nil
      return true
    end

    return false
  end

  t.job = job
  start(job)
end

-- The methods of a tween.
const TweenMethods = {}

--- Moves the tween to `value`. `options` sets `duration`, `easing`, and
--- `delay` for this move; with `instant`, it jumps there.
--- @method set
--- @within Tween
--- @param value -- The new target
--- @param options -- The options of this move
function TweenMethods.set(object: TweenObject, value: unknown, options: SetOptions?) -> ()
  local t = object.__svelte_tween

  if options ~= nil and options.instant then
    if t.job ~= nil then
      stop(t.job)
      t.job = nil
    end

    t.output.value = value
  end

  t.next = options
  t.target.value = value
  t.next = nil
end

-- The metatable of tweens.
const TweenObjects = {}

function TweenObjects.__index(object: TweenObject, key: unknown) -> unknown
  const t = object.__svelte_tween

  if key == 'current' or key == 'value' then
    return t.output.value
  elseif key == 'target' then
    return t.target.value
  elseif key is string and TweenMethods[key] ~= nil then
    return TweenMethods[key]
  end

  error(`svelte-aly: a tween has no key '{tostring(key)}'`, 2)
end

function TweenObjects.__newindex(object: TweenObject, key: unknown, value: unknown) -> ()
  if key ~= 'target' then
    error(`svelte-aly: a tween takes a write of .target, not of '{tostring(key)}'`, 2)
  end

  object.__svelte_tween.target.value = value
end

function TweenObjects.__tostring(object: TweenObject) -> string
  return tostring(object.__svelte_tween.output.value)
end

readable_metatable(TweenObjects)

--- @class Tween
--- Svelte's `Tween`: `new Tween(value, options)`, or `Tween.of(fn,
--- options)` to follow what `fn` reads. See [TweenOptions].
export namespace Tween
  --- A tween at `value`. Write `.target` to move it.
  --- @function new
  --- @within Tween
  --- @param value T -- The first value
  --- @param options TweenOptions? -- How the tween moves
  --- @return Tween<T> -- The tween
  @allow(explicit_any)
  public function new<T>(value: T, options: TweenOptions?) -> Tween<T>
    const t: Tweening = {
      output = state(value :: unknown),
      target = state(value :: unknown),
      options = options ?? {},
      next = nil,
      job = nil,
    }

    effect(function()
      const goal = t.target.value
      untrack(function() move(t, goal) end)
    end)

    if current_owner() ~= nil then
      on_destroy(function()
        if t.job ~= nil then
          stop(t.job)
        end
      end)
    end

    return (setmetatable({ __svelte_tween = t }, TweenObjects) :: any) :: Tween<T>
  end

  --- A tween that follows what `fn` gives, as Svelte's `Tween.of`.
  --- @function of
  --- @within Tween
  --- @param fn () -> T -- Gives the target, from the states it reads
  --- @param options TweenOptions? -- How the tween moves
  --- @return Tween<T> -- The tween
  public function of<T>(fn: () -> T, options: TweenOptions?) -> Tween<T>
    local tween = new Tween(untrack(fn), options)

    effect(function()
      const goal = fn()
      untrack(function() tween.target = goal end)
    end)

    return tween
  end
end

--- @class Springs
--- Apple's spring presets. Each takes a `duration`, 0.5 by default, and
--- an `extra_bounce` to add on top of its own.
export namespace Springs
  --- No bounce: a smooth settle.
  --- @function smooth
  --- @within Springs
  --- @param duration number? -- The time to settle, 0.5 by default
  --- @param extra_bounce number? -- The bounce to add, 0 by default
  --- @return SpringOptions -- The options for [Spring]
  public function smooth(duration: number?, extra_bounce: number?) -> SpringOptions
    return { duration = duration ?? 0.5, bounce = 0 + (extra_bounce ?? 0) }
  end

  --- A small bounce, quick to settle.
  --- @function snappy
  --- @within Springs
  --- @param duration number? -- The time to settle, 0.5 by default
  --- @param extra_bounce number? -- The bounce to add, 0 by default
  --- @return SpringOptions -- The options for [Spring]
  public function snappy(duration: number?, extra_bounce: number?) -> SpringOptions
    return { duration = duration ?? 0.5, bounce = 0.15 + (extra_bounce ?? 0) }
  end

  --- A clear bounce.
  --- @function bouncy
  --- @within Springs
  --- @param duration number? -- The time to settle, 0.5 by default
  --- @param extra_bounce number? -- The bounce to add, 0 by default
  --- @return SpringOptions -- The options for [Spring]
  public function bouncy(duration: number?, extra_bounce: number?) -> SpringOptions
    return { duration = duration ?? 0.5, bounce = 0.3 + (extra_bounce ?? 0) }
  end

  --- SwiftUI's interactive spring, for a value that follows a finger or a
  --- drag: quick, and damped near critical.
  --- @function interactive
  --- @within Springs
  --- @return SpringOptions -- The options for [Spring]
  public function interactive() -> SpringOptions
    return { response = 0.15, damping_ratio = 0.86 }
  end
end

@test
namespace MotionTests
  -- Moves time by `seconds`, in frames of `dt`.
  private function run_for(seconds: number, dt: number) -> ()
    for _ = 1, math.round(seconds / dt) do
      step(dt)
    end
  end

  --- A spring comes to rest at its target.
  public function a_spring_rests_at_its_target() -> ()
    manual_frames()
    local moving = new Spring(0, { duration = 0.5 })

    moving.target = 10
    step(1 / 60)
    $assert(moving.current < 10)
    $assert(not moving.resting)
    run_for(3, 1 / 60)

    $assert_eq(moving.current, 10)
    $assert(moving.resting)
  end

  --- A bounce goes past the target; a smooth spring never does.
  public function a_bounce_overshoots_and_a_smooth_spring_does_not() -> ()
    manual_frames()
    local bouncy = new Spring(0, Springs.bouncy(0.5, 0.2))
    local smooth = new Spring(0, Springs.smooth(0.5))
    local bouncy_peak, smooth_peak = 0, 0

    bouncy.target = 1
    smooth.target = 1

    for _ = 1, 180 do
      step(1 / 60)
      bouncy_peak = math.max(bouncy_peak, bouncy.current)
      smooth_peak = math.max(smooth_peak, smooth.current)
    end

    $assert(bouncy_peak > 1.05)
    $assert(smooth_peak <= 1 + 1e-9)
  end

  --- The solver is exact, so the frame rate does not change the motion:
  --- one second in 30 steps lands where one second in 240 steps does.
  public function the_solver_gives_one_motion_at_any_frame_rate() -> ()
    for _, zeta in [ 0.4, 1, 1.8 ] do
      local x30, v30 = 5, 0
      local x240, v240 = 5, 0

      for _ = 1, 30 do
        x30, v30 = solve(x30, v30, 12, zeta, 1 / 30)
      end

      for _ = 1, 240 do
        x240, v240 = solve(x240, v240, 12, zeta, 1 / 240)
      end

      $assert(math.abs(x30 - x240) < 1e-9)
      $assert(math.abs(v30 - v240) < 1e-9)
    end
  end

  --- Apple's duration and bounce give a damping ratio of 1 - bounce.
  public function a_bounce_sets_the_damping_ratio() -> ()
    const omega, zeta = tuning({ duration = 0.5, bounce = 0.3 })

    $assert(math.abs(omega - 4 * math.pi) < 1e-9)
    $assert(math.abs(zeta - 0.7) < 1e-9)
  end

  --- An impulse moves a spring at rest, and it comes back.
  public function an_impulse_moves_a_spring_at_rest() -> ()
    manual_frames()
    const moving = new Spring(0, { duration = 0.4 })

    moving:impulse(20)
    step(1 / 60)
    $assert(moving.current > 0)
    $assert(moving:velocity() ~= 0)

    run_for(3, 1 / 60)
    $assert_eq(moving.current, 0)
  end

  --- `set` with `instant` jumps and rests.
  public function an_instant_set_jumps() -> ()
    manual_frames()
    const moving = new Spring(new Vector2(0, 0))

    moving:set(new Vector2(4, 2), { instant = true })

    $assert_eq(moving.current, new Vector2(4, 2))
    $assert(moving.resting)
  end

  --- Spring.of follows the states that its function reads.
  public function spring_of_follows_a_state() -> ()
    manual_frames()
    local open = state(false)
    const width = Spring.of(function() return if open.value then 200 else 0 end, Springs.snappy())

    open.value = true
    run_for(3, 1 / 60)

    $assert_eq(width.target, 200)
    $assert_eq(width.current, 200)
  end

  --- A tween reaches its target at the end of its duration, along its curve.
  public function a_tween_follows_its_curve() -> ()
    manual_frames()
    local moving = new Tween(0, { duration = 1, easing = Easing.linear })

    moving.target = 10
    run_for(0.5, 0.1)
    $assert(math.abs(moving.current - 5) < 1e-9)

    run_for(0.6, 0.1)
    $assert_eq(moving.current, 10)
  end

  --- A tween's `set` takes the options of one move.
  public function a_tween_set_takes_its_options() -> ()
    manual_frames()
    const moving = new Tween(0, { duration = 10 })

    moving:set(4, { duration = 1, easing = Easing.linear })
    run_for(0.5, 0.1)

    $assert(math.abs(moving.current - 2) < 1e-9)
  end

  --- A template binds a spring as it binds a state.
  public function a_template_binds_a_spring() -> ()
    manual_frames()
    local size = new Spring(new UDim2(0, 10, 0, 10), Springs.smooth(0.3))
    const frame = create('Frame')({ Size = size }) :: Frame

    size.target = new UDim2(0, 50, 0, 50)
    run_for(2, 1 / 60)

    $assert_eq(frame.Size, new UDim2(0, 50, 0, 50))
  end

  --- The curves give what CSS, Roblox, and Svelte give.
  public function the_easing_curves_match_their_sources() -> ()
    $assert(math.abs(Easing.cubic_bezier(0, 0, 1, 1)(0.3) - 0.3) < 1e-6)
    $assert(math.abs(Easing.ease_in_out(0.5) - 0.5) < 1e-6)
    $assert_eq(Easing.style('Quad', 'In')(0.5), 0.25)
    $assert_eq(Easing.quad_out(0.5), 0.75)
    $assert_eq(Easing.quad_in_out(0.25), 0.125)
    $assert(math.abs(Easing.cubic_out(0.5) - 0.875) < 1e-9)
  end

  --- lerp blends each kind of value part by part.
  public function lerp_blends_the_parts() -> ()
    const half = lerp(new UDim2(0, 0, 1, 10), new UDim2(1, 100, 1, 30), 0.5)

    $assert_eq(half, new UDim2(0.5, 50, 1, 20))

    const color = lerp(new Color3(1, 0, 0), new Color3(1, 0, 0), 0.5)
    $assert(math.abs(color.R - 1) < 1e-6 and math.abs(color.G) < 1e-6)
  end
end
