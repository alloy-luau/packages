--[[
  Motion: springs, tweens, easing curves, and `lerp`, after
  `svelte/motion` and `svelte/easing`. The model of the springs is
  Bevel's, and its parameters follow Apple's.

  `new Spring(0)` and `new Tween(0)` hold a value. Write `.target`, and
  `.current` moves to it frame by frame. `Spring.of(fn)` and
  `Tween.of(fn)` follow what `fn` reads. A template binds a spring or a
  tween as it binds a state: `Size={size}`.

  Both move the parts of a value: a number, a Vector2, a Vector3, a UDim,
  a UDim2, a Color3, a CFrame, or a Rect. A Color3 moves in Oklab, so a
  blend of two colors keeps its lightness.

  The spring solves the damped oscillator exactly at each frame, so it
  moves the same at 30 or 240 frames a second, and a new target keeps
  the velocity of the old motion. Its parameters are a perceptual
  `duration` and a `bounce`, or `response` and `damping_ratio`, or
  `mass`, `stiffness`, and `damping`.
]]

--- @class motion
--- Springs, tweens, and blends. [Spring] and [Tween] each hold a value
--- that moves to its target, and read as a state. The curves are in
--- [Easing], and Apple's spring presets in [Springs].
--- Import these from `@packages/svelte-aly`.

import {
  current_owner,
  effect,
  on_destroy,
  readable_metatable,
  state,
  untrack,
  type State,
} from './reactive'
import { manual_frames, start, step, stop, type Job } from './frame'
import { create } from './template'

-- The kinds of value that move, and how many parts each has.
type Kind = 'number' | 'Vector2' | 'Vector3' | 'UDim' | 'UDim2' | 'Color3' | 'CFrame' | 'Rect'

-- sRGB to linear light, and back.
local function to_linear(c: number) -> number
  return if c <= 0.04045 then c / 12.92 else ((c + 0.055) / 1.055) ^ 2.4
end

local function to_gamma(c: number) -> number
  return if c <= 0.0031308 then c * 12.92 else 1.055 * c ^ (1 / 2.4) - 0.055
end

-- A Color3 in Oklab: lightness, then two axes of hue.
local function to_oklab(color: Color3) -> { number }
  const r, g, b = to_linear(color.R), to_linear(color.G), to_linear(color.B)
  const l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ^ (1 / 3)
  const m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ^ (1 / 3)
  const s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ^ (1 / 3)

  return [
    0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s,
  ]
end

local function from_oklab(lab: { number }) -> Color3
  const l = (lab[1] + 0.3963377774 * lab[2] + 0.2158037573 * lab[3]) ^ 3
  const m = (lab[1] - 0.1055613458 * lab[2] - 0.0638541728 * lab[3]) ^ 3
  const s = (lab[1] - 0.0894841775 * lab[2] - 1.291485548 * lab[3]) ^ 3
  const r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
  const g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
  const b = -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s

  return new Color3(
    math.clamp(to_gamma(r), 0, 1),
    math.clamp(to_gamma(g), 0, 1),
    math.clamp(to_gamma(b), 0, 1)
  )
end

-- The kind of a value and its parts, as plain numbers.
local function pack(value: unknown) -> (Kind, { number })
  if value is number then
    return 'number', [ value ]
  elseif value is Vector2 then
    return 'Vector2', [ value.X, value.Y ]
  elseif value is Vector3 then
    return 'Vector3', [ value.X, value.Y, value.Z ]
  elseif value is UDim then
    return 'UDim', [ value.Scale, value.Offset ]
  elseif value is UDim2 then
    return 'UDim2', [ value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset ]
  elseif value is Color3 then
    return 'Color3', to_oklab(value)
  elseif value is CFrame then
    return 'CFrame', [ value:GetComponents() ]
  elseif value is Rect then
    return 'Rect', [ value.Min.X, value.Min.Y, value.Max.X, value.Max.Y ]
  end

  error(
    `svelte-aly cannot animate a {typeof(value)}; it moves numbers, Vector2, Vector3, UDim, UDim2, Color3, CFrame, and Rect`,
    0
  )
end

-- The value of a kind from its parts.
local function unpack(kind: Kind, p: { number }) -> unknown
  match kind with
    case 'number' then return p[1]
    case 'Vector2' then return new Vector2(p[1], p[2])
    case 'Vector3' then return new Vector3(p[1], p[2], p[3])
    case 'UDim' then return new UDim(p[1], p[2])
    case 'UDim2' then return new UDim2(p[1], p[2], p[3], p[4])
    case 'Color3' then return from_oklab(p)
    case 'CFrame' then
      const frame = new CFrame(
        p[1],
        p[2],
        p[3],
        p[4],
        p[5],
        p[6],
        p[7],
        p[8],
        p[9],
        p[10],
        p[11],
        p[12]
      )
      return frame:Orthonormalize()
    default return new Rect(p[1], p[2], p[3], p[4])
  end
end

--- A blend of two values of one kind: `a` at 0, `b` at 1. A Color3
--- blends in Oklab; a CFrame blends its rotation the short way round.
--- @within motion
--- @param a -- The value at 0
--- @param b -- The value at 1, of the same kind as `a`
--- @param t -- How far to go from `a` to `b`
--- @return T -- The blend
--- @error string -- When `a` or `b` is a kind of value that svelte-aly cannot move
@allow(explicit_any)
export function lerp<T>(a: T, b: T, t: number) -> T
  if a is CFrame and b is CFrame then
    const from, to = (a :: any) :: CFrame, (b :: any) :: CFrame
    return (from:Lerp(to, t) :: any) :: T
  end

  const kind, from = pack(a)
  const _, to = pack(b)
  local out: { number } = {}

  for i, x in from do
    out[i] = x + (to[i] - x) * t
  end

  return unpack(kind, out) :: T
end

--- The options of a spring. Write one of three forms; the first form
--- that has a field wins, in this order:
---
--- - `duration` and `bounce`, as Apple's `Spring(duration:bounce:)`.
---   `duration` is the perceptual time to settle, 0.5 by default.
---   `bounce` is 0 for no overshoot, up to 1 for more, and below 0 for an
---   overdamped spring.
--- - `response` and `damping_ratio`, as SwiftUI's
---   `.spring(response:dampingFraction:)`. A `damping_ratio` of 1 is
---   critical damping.
--- - `mass`, `stiffness`, and `damping`, the physical form.
---
--- `velocity` sets the start velocity. `threshold` sets how near the
--- target the spring rests, 0.001 by default.
export type SpringOptions = {
  duration: number?,
  bounce: number?,
  response: number?,
  damping_ratio: number?,
  mass: number?,
  stiffness: number?,
  damping: number?,
  velocity: unknown?,
  threshold: number?,
}

-- A spring's natural frequency and damping ratio, from its options.
local function tuning(options: SpringOptions) -> (number, number)
  const physical = options.mass ~= nil or options.stiffness ~= nil or options.damping ~= nil

  if physical and options.duration == nil and options.response == nil then
    const mass = options.mass ?? 1
    const stiffness = options.stiffness ?? 100
    const damping = options.damping ?? 10

    return math.sqrt(stiffness / mass), damping / (2 * math.sqrt(stiffness * mass))
  end

  if options.response ~= nil and options.duration == nil then
    return 2 * math.pi / options.response, options.damping_ratio ?? 1
  end

  const duration = options.duration ?? 0.5
  const bounce = math.clamp(options.bounce ?? 0, -1, 0.999)
  const omega = 2 * math.pi / duration
  const damping = if bounce >= 0
    then (1 - bounce) * 4 * math.pi / duration
    else 4 * math.pi / (duration * (1 + bounce))

  return omega, damping / (2 * omega)
end

-- Moves one part of a spring by `dt`: the exact solution of the damped
-- oscillator from the offset `x` from the target and the velocity `v`.
local function solve(
  x: number,
  v: number,
  omega: number,
  zeta: number,
  dt: number
) -> (number, number)
  if math.abs(zeta - 1) < 1e-6 then
    const decay = math.exp(-omega * dt)
    const b = v + omega * x

    return (x + b * dt) * decay, (v - omega * b * dt) * decay
  elseif zeta < 1 then
    const wd = omega * math.sqrt(1 - zeta * zeta)
    const a = zeta * omega
    const b = (v + a * x) / wd
    const decay = math.exp(-a * dt)
    const c, s = math.cos(wd * dt), math.sin(wd * dt)

    return decay * (x * c + b * s), decay * ((wd * b - a * x) * c - (a * b + wd * x) * s)
  else
    const root = omega * math.sqrt(zeta * zeta - 1)
    const r1, r2 = -zeta * omega + root, -zeta * omega - root
    const c2 = (v - r1 * x) / (r2 - r1)
    const c1 = x - c2
    const e1, e2 = math.exp(r1 * dt), math.exp(r2 * dt)

    return c1 * e1 + c2 * e2, c1 * r1 * e1 + c2 * r2 * e2
  end
end

--- How `set` moves a spring or a tween. `instant` jumps to the value.
--- A tween also takes `duration`, `easing`, and `delay` for this move.
export type SetOptions = {
  instant: boolean?,
  duration: number?,
  easing: ((t: number) -> number)?,
  delay: number?,
}

--- A value that moves to its target with a spring: what
--- `new Spring(value)` and `Spring.of(fn)` give. `current` is the value
--- now; write `target` to move it. `resting` is true while it rests.
--- @type Spring { read current: T, read value: T, target: T, read resting: boolean }
export type Spring<T> = {
  read current: T,
  read value: T,
  target: T,
  read resting: boolean,
  set: (self: Spring<T>, value: T, options: SetOptions?) -> (),
  impulse: (self: Spring<T>, velocity: T) -> (),
  velocity: (self: Spring<T>) -> T,
}

-- The state of one spring.
type Motion = {
  kind: Kind,
  current: { number },
  speeds: { number },
  goal: { number },
  omega: number,
  zeta: number,
  threshold: number,
  output: State<unknown>,
  target: State<unknown>,
  resting: State<boolean>,
  job: Job?,
}

-- What code holds: the spring under a raw key.
type SpringObject = { __svelte_spring: Motion }

-- Writes the position into the output.
local function publish(m: Motion) -> ()
  m.output.value = unpack(m.kind, m.current)
end

-- Moves the parts of a spring by `dt`. Gives true when it rests.
local function advance(m: Motion, dt: number) -> boolean
  local still = true

  for i, target in m.goal do
    const x, v = solve(m.current[i] - target, m.speeds[i], m.omega, m.zeta, dt)
    m.current[i] = target + x
    m.speeds[i] = v

    if math.abs(x) > m.threshold or math.abs(v) > m.threshold then
      still = false
    end
  end

  if still then
    m.current = table.clone(m.goal)
    m.speeds = table.create(#m.goal, 0)
  end

  return still
end

-- Whether a spring stands still at `parts`, so a move there has nothing
-- to do.
local function rests_on(m: Motion, parts: { number }) -> boolean
  for i, x in parts do
    if m.current[i] ~= x or m.speeds[i] ~= 0 then
      return false
    end
  end

  return true
end

-- Puts a spring on the frame loop, once.
local function wake(m: Motion) -> ()
  if m.job ~= nil then
    return
  end

  m.resting.value = false

  const job = function(dt: number) -> boolean
    const still = advance(m, dt)

    if still then
      m.job = nil
      m.resting.value = true
    end

    publish(m)
    return still
  end

  m.job = job
  start(job)
end

-- Takes a spring off the frame loop.
local function halt(m: Motion) -> ()
  if m.job ~= nil then
    stop(m.job)
    m.job = nil
  end
end

-- The methods of a spring.
const SpringMethods = {}

--- Moves the spring to `value`. With `instant`, it jumps there and
--- rests.
--- @method set
--- @within Spring
--- @param value -- The new target
--- @param options -- `instant` to jump
function SpringMethods.set(object: SpringObject, value: unknown, options: SetOptions?) -> ()
  local m = object.__svelte_spring

  if options ~= nil and options.instant then
    const _, parts = pack(value)
    halt(m)
    m.current, m.goal = table.clone(parts), parts
    m.speeds = table.create(#parts, 0)
    publish(m)
    m.resting.value = true
  end

  m.target.value = value
end

--- Adds to the velocity, in units a second: a push.
--- @method impulse
--- @within Spring
--- @param velocity -- The velocity to add
function SpringMethods.impulse(object: SpringObject, velocity: unknown) -> ()
  const m = object.__svelte_spring
  const _, parts = pack(velocity)

  for i, v in parts do
    m.speeds[i] += v
  end

  wake(m)
end

--- The velocity now, as a value of the spring's kind.
--- @method velocity
--- @within Spring
--- @return unknown -- The velocity
function SpringMethods.velocity(object: SpringObject) -> unknown
  const m = object.__svelte_spring

  return unpack(m.kind, table.clone(m.speeds))
end

-- The metatable of springs. `current`, `target`, and `resting` read
-- the states inside, so a read links the reader.
const SpringObjects = {}

function SpringObjects.__index(object: SpringObject, key: unknown) -> unknown
  const m = object.__svelte_spring

  if key == 'current' or key == 'value' then
    return m.output.value
  elseif key == 'target' then
    return m.target.value
  elseif key == 'resting' then
    return m.resting.value
  elseif key is string and SpringMethods[key] ~= nil then
    return SpringMethods[key]
  end

  error(`svelte-aly: a spring has no key '{tostring(key)}'`, 2)
end

function SpringObjects.__newindex(object: SpringObject, key: unknown, value: unknown) -> ()
  if key ~= 'target' then
    error(`svelte-aly: a spring takes a write of .target, not of '{tostring(key)}'`, 2)
  end

  object.__svelte_spring.target.value = value
end

function SpringObjects.__tostring(object: SpringObject) -> string
  return tostring(object.__svelte_spring.output.value)
end

readable_metatable(SpringObjects)

--- @class Spring
--- Svelte's `Spring`: `new Spring(value, options)`, or `Spring.of(fn,
--- options)` to follow what `fn` reads. See [SpringOptions] and [Springs].
export namespace Spring
  --- A spring at `value`. Write `.target` to move it.
  --- @function new
  --- @within Spring
  --- @param value T -- The first value
  --- @param options SpringOptions? -- How the spring moves
  --- @return Spring<T> -- The spring
  --- @error string -- When the value is a kind that svelte-aly cannot move
  -- The object reads through its metatable, so the cast goes through `any`.
  @allow(explicit_any)
  public function new<T>(value: T, options: SpringOptions?) -> Spring<T>
    const tuned: SpringOptions = options ?? {}
    const omega, zeta = tuning(tuned)
    const kind, parts = pack(value)
    local speeds: { number } = table.create(#parts, 0)

    if tuned.velocity ~= nil then
      const _, given = pack(tuned.velocity)
      speeds = given
    end

    local m: Motion = {
      kind = kind,
      current = table.clone(parts),
      speeds = speeds,
      goal = parts,
      omega = omega,
      zeta = zeta,
      threshold = tuned.threshold ?? 0.001,
      output = state(value :: unknown),
      target = state(value :: unknown),
      resting = state(true),
      job = nil,
    }

    effect(function()
      const next_kind, next_parts = pack(m.target.value)
      assert(next_kind == m.kind, `a spring of {m.kind} cannot move to a {next_kind}`)
      untrack(function()
        m.goal = next_parts

        if not rests_on(m, next_parts) then
          wake(m)
        end
      end)
    end)

    if current_owner() ~= nil then
      on_destroy(function() halt(m) end)
    end

    return (setmetatable({ __svelte_spring = m }, SpringObjects) :: any) :: Spring<T>
  end

  --- A spring that follows what `fn` gives, as Svelte's `Spring.of`.
  --- @function of
  --- @within Spring
  --- @param fn () -> T -- Gives the target, from the states it reads
  --- @param options SpringOptions? -- How the spring moves
  --- @return Spring<T> -- The spring
  public function of<T>(fn: () -> T, options: SpringOptions?) -> Spring<T>
    local spring = new Spring(untrack(fn), options)

    effect(function()
      const goal = fn()
      untrack(function() spring.target = goal end)
    end)

    return spring
  end
end

--- An easing curve: progress from 0 to 1 in, eased progress out.
export type Easing = (t: number) -> number

--- @class Easing
--- Easing curves for [Tween], with Roblox's styles and the names of
--- `svelte/easing`.
export namespace Easing
  --- A curve as CSS and Core Animation write it: a cubic Bézier from
  --- (0, 0) to (1, 1), with the control points (x1, y1) and (x2, y2).
  --- @function cubic_bezier
  --- @within Easing
  --- @param x1 number -- The x of the first control point
  --- @param y1 number -- The y of the first control point
  --- @param x2 number -- The x of the second control point
  --- @param y2 number -- The y of the second control point
  --- @return Easing -- The curve
  public function cubic_bezier(x1: number, y1: number, x2: number, y2: number) -> Easing
    -- The x and y of the curve at the parameter u.
    local function curve(a: number, b: number, u: number) -> number
      return 3 * a * (1 - u) ^ 2 * u + 3 * b * (1 - u) * u ^ 2 + u ^ 3
    end

    return function(t: number) -> number
      if t <= 0 or t >= 1 then
        return math.clamp(t, 0, 1)
      end

      -- Find the u where x is t: bisection, which cannot diverge.
      local low, high = 0, 1

      for _ = 1, 30 do
        const mid = (low + high) / 2

        if curve(x1, x2, mid) < t then
          low = mid
        else
          high = mid
        end
      end

      return curve(y1, y2, (low + high) / 2)
    end
  end

  --- No easing.
  --- @function linear
  --- @within Easing
  --- @param t number -- The progress, from 0 to 1
  --- @return number -- The same progress
  public function linear(t: number) -> number
    return t
  end

  --- Core Animation's ease in: slow at the start.
  --- @prop ease_in Easing
  --- @within Easing
  --- @readonly
  public const ease_in: Easing = cubic_bezier(0.42, 0, 1, 1)

  --- Core Animation's ease out: slow at the end.
  --- @prop ease_out Easing
  --- @within Easing
  --- @readonly
  public const ease_out: Easing = cubic_bezier(0, 0, 0.58, 1)

  --- Core Animation's ease in and out: slow at both ends.
  --- @prop ease_in_out Easing
  --- @within Easing
  --- @readonly
  public const ease_in_out: Easing = cubic_bezier(0.42, 0, 0.58, 1)

  --- The shapes of Roblox's `Enum.EasingStyle`, by name.
  --- @type Style 'Linear' | 'Sine' | 'Quad' | 'Cubic' | 'Quart' | 'Quint' | 'Exponential' | 'Circular' | 'Back' | 'Elastic' | 'Bounce'
  --- @within Easing
  public type Style = 'Linear' | 'Sine' | 'Quad' | 'Cubic' | 'Quart' | 'Quint' | 'Exponential' | 'Circular' | 'Back' | 'Elastic' | 'Bounce'

  --- The sides of a curve that ease, as `Enum.EasingDirection` names them.
  --- @type Direction 'In' | 'Out' | 'InOut'
  --- @within Easing
  public type Direction = 'In' | 'Out' | 'InOut'

  -- The In form of each style.
  local function ease_in_of(style: Style, t: number) -> number
    match style with
      case 'Linear' then return t
      case 'Sine' then return 1 - math.cos(t * math.pi / 2)
      case 'Quad' then return t ^ 2
      case 'Cubic' then return t ^ 3
      case 'Quart' then return t ^ 4
      case 'Quint' then return t ^ 5
      case 'Exponential' then return if t == 0 then 0 else 2 ^ (10 * t - 10)
      case 'Circular' then return 1 - math.sqrt(1 - t * t)
      case 'Back' then return 2.70158 * t ^ 3 - 1.70158 * t ^ 2
      case 'Elastic' then
        if t == 0 or t == 1 then
          return t
        end

        return -(2 ^ (10 * t - 10)) * math.sin((t * 10 - 10.75) * (2 * math.pi / 3))
      default
        const u = 1 - t
        local out = 0

        if u < 1 / 2.75 then
          out = 7.5625 * u * u
        elseif u < 2 / 2.75 then
          const w = u - 1.5 / 2.75
          out = 7.5625 * w * w + 0.75
        elseif u < 2.5 / 2.75 then
          const w = u - 2.25 / 2.75
          out = 7.5625 * w * w + 0.9375
        else
          const w = u - 2.625 / 2.75
          out = 7.5625 * w * w + 0.984375
        end

        return 1 - out
    end
  end

  --- A Roblox easing style as a curve: `style('Quad', 'Out')`. The
  --- direction is `Out` by default, as it is in a `TweenInfo`.
  --- @function style
  --- @within Easing
  --- @param name Style -- The easing style
  --- @param direction Direction? -- The side that eases, `Out` by default
  --- @return Easing -- The curve
  public function style(name: Style, direction: Direction?) -> Easing
    const side = direction ?? 'Out'

    return function(t: number) -> number
      match side with
        case 'In' then return ease_in_of(name, t)
        case 'Out' then return 1 - ease_in_of(name, 1 - t)
        default
          return if t < 0.5
            then ease_in_of(name, 2 * t) / 2
            else 1 - ease_in_of(name, 2 - 2 * t) / 2
      end
    end
  end

  --- Svelte's `sineIn`: `style('Sine', 'In')`.
  --- @prop sine_in Easing
  --- @within Easing
  --- @readonly
  public const sine_in: Easing = style('Sine', 'In')

  --- Svelte's `sineOut`: `style('Sine', 'Out')`.
  --- @prop sine_out Easing
  --- @within Easing
  --- @readonly
  public const sine_out: Easing = style('Sine', 'Out')

  --- Svelte's `sineInOut`: `style('Sine', 'InOut')`.
  --- @prop sine_in_out Easing
  --- @within Easing
  --- @readonly
  public const sine_in_out: Easing = style('Sine', 'InOut')

  --- Svelte's `quadIn`: `style('Quad', 'In')`.
  --- @prop quad_in Easing
  --- @within Easing
  --- @readonly
  public const quad_in: Easing = style('Quad', 'In')

  --- Svelte's `quadOut`: `style('Quad', 'Out')`.
  --- @prop quad_out Easing
  --- @within Easing
  --- @readonly
  public const quad_out: Easing = style('Quad', 'Out')

  --- Svelte's `quadInOut`: `style('Quad', 'InOut')`.
  --- @prop quad_in_out Easing
  --- @within Easing
  --- @readonly
  public const quad_in_out: Easing = style('Quad', 'InOut')

  --- Svelte's `cubicIn`: `style('Cubic', 'In')`.
  --- @prop cubic_in Easing
  --- @within Easing
  --- @readonly
  public const cubic_in: Easing = style('Cubic', 'In')

  --- Svelte's `cubicOut`: `style('Cubic', 'Out')`.
  --- @prop cubic_out Easing
  --- @within Easing
  --- @readonly
  public const cubic_out: Easing = style('Cubic', 'Out')

  --- Svelte's `cubicInOut`: `style('Cubic', 'InOut')`.
  --- @prop cubic_in_out Easing
  --- @within Easing
  --- @readonly
  public const cubic_in_out: Easing = style('Cubic', 'InOut')

  --- Svelte's `quartIn`: `style('Quart', 'In')`.
  --- @prop quart_in Easing
  --- @within Easing
  --- @readonly
