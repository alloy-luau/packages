--[[
  Forge: OOP providers for Alloy, after Chief. This module sends out the
  public API of the core; each part lives in its own module beside it.

    import { Forge, Provider, Lifecycle } from 'forge/src/index'

  The file features send out their own names. The link file that Ember
  writes joins each enabled feature to this module:

    lifecycles    every
    dependencies  use, Target
    traits        Trait, TraitLifecycle, Attribute, Child
    bin           Bin, BinItem
]]

export { Forge, Phase, ProviderEvent, type Extension, type Options } from './core'
export {
  Dispatch,
  Lifecycle,
  Provider,
  type CustomLifecycle,
  type Entry,
  type Fire,
  type ProviderObject,
} from './provider'
