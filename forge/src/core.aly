--[[
  The core of Forge: it loads the providers, runs the Init and Start
  barrier, and tells extensions at each step. The file features
  (lifecycles, dependencies, traits) plug into the same steps through
  `hook`; an extension of the game's own can hook into them too.

    new Forge()
      :AddProviders(script.Parent->'Providers'!:GetChildren())
      :Start()

  The boot runs these phases in order:

    PreLoad -> Load -> PostLoad -> PreInit -> Init -> PostInit
      -> PreStart -> Start -> PostStart

  The core never requires a feature module. Install deletes the files of
  a feature that is off, so such a require would fail.
]]

--- @class core
--- The boot phases and the provider events that an [Extension] hears, and
--- the types of the [Forge] options and extensions.
---
--- Import these from `@packages/forge`.

import { HashMap, Set } from '@alloy/std/collections'
import {
  type CustomLifecycle,
  type Entry,
  Lifecycle,
  Provider,
  check_contract,
  exported,
  is_boot,
  options_of,
  unlisted,
} from './provider'
import { run_sync } from './sync'

--- A boot phase an [Extension] hears. Load, Init and Start run between
--- them, and no hook fires for those three.
---
--- @type Phase "PreLoad" | "PostLoad" | "PreInit" | "PostInit" | "PreStart" | "PostStart"
--- @within core
export enum Phase
  PreLoad
  PostLoad
  PreInit
  PostInit
  PreStart
  PostStart
end

--- A step of one provider that an [Extension] hears.
---
--- @type ProviderEvent "Loaded" | "Initialized" | "Started"
--- @within core
export enum ProviderEvent
  Loaded
  Initialized
  Started
end

--- Options for `new Forge(options)`. The boot summary reads
--- `Forge (Server) started 12 providers in 3ms`.
---
--- @interface Options
--- .Verbose boolean? -- True or nil prints the boot summary. False prints nothing.
export type Options = { Verbose: boolean? }

--- @class Forge
--- The Forge class: one boot of a set of providers.
export struct Forge
  private verbose: boolean
  private modules: { ModuleScript } = {}
  private added: Set<ModuleScript> = new Set()
  private entries: { Entry } = {}
  private by_module: HashMap<ModuleScript, Entry> = new HashMap()
  private structs: Set<unknown> = new Set()
  private extensions: { Extension } = {}
  -- Where the boot is: Idle, a Phase, Load, Init, or Start.
  private phase: string = 'Idle'
  private started: boolean = false
end

--- An extension: a name and up to two hooks. Add one with
--- [Forge:AddExtension].
---
--- `onPhase` gets every entry loaded so far. At PostLoad an extension may
--- call [Forge:LoadProvider]. At PostLoad or PreInit it may reorder
--- `entries` in place. Past PreInit the order is final. `onProvider` fires
--- as each provider loads, initializes, and starts.
---
--- @interface Extension
--- .Name string -- The name of the extension
--- .onPhase ((forge: Forge, phase: Phase, entries: { Entry }) -> ())? -- Fires at each [Phase]
--- .onProvider ((forge: Forge, event: ProviderEvent, entry: Entry) -> ())? -- Fires at each step
export type Extension = {
  Name: string,
  onPhase: ((forge: Forge, phase: Phase, entries: { Entry }) -> ())?,
  onProvider: ((forge: Forge, event: ProviderEvent, entry: Entry) -> ())?,
}

--- The hook of the file features. A feature module fills its part when it
--- loads, so a game turns a feature on in `ember.toml` and changes no
--- code. Each Forge runs `extensions` before its own extensions. Each call
--- serves the Forge methods of one feature, and stays nil while that
--- feature is off.
---
--- @interface Hook
--- @within core
--- @private
--- .extensions { Extension } -- The extensions of the features, in load order
--- .AddLifecycle ((forge: Forge, lifecycle: CustomLifecycle) -> ())? -- Serves [Forge:AddLifecycle]
--- .every ((seconds: number, method: string) -> CustomLifecycle)? -- Serves [Forge.every]
--- .use ((target: string | ModuleScript) -> any)? -- Serves [Forge.use]
--- .AddTrait ((forge: Forge, module: ModuleScript) -> ())? -- Serves [Forge:AddTrait]
--- .trait ((instance: Instance, trait: unknown) -> unknown)? -- Serves [Forge.trait]
--- .traits ((trait: unknown) -> { unknown })? -- Serves [Forge.traits]
@allow(explicit_any)
export type Hook = {
  extensions: { Extension },
  AddLifecycle: ((forge: Forge, lifecycle: CustomLifecycle) -> ())?,
  every: ((seconds: number, method: string) -> CustomLifecycle)?,
  use: ((target: string | ModuleScript) -> any)?,
  AddTrait: ((forge: Forge, module: ModuleScript) -> ())?,
  trait: ((instance: Instance, trait: unknown) -> unknown)?,
  traits: ((trait: unknown) -> { unknown })?,
}

--- The one hook that every feature module plugs into.
---
--- @prop hook Hook
--- @within core
--- @private
export const hook: Hook = { extensions = {} }

--- The call that a feature serves, or an error that names the feature
--- when it is off.
local function served<F>(call: F?, feature: string, method: string) -> F
  if call == nil then
    error(
      `MissingFeature: {method} needs the {feature} feature of alloy/forge; turn it on in ember.toml`,
      0
    )
  end

  return call
end

--- Errors unless a value is a ModuleScript.
local function check_module(value: unknown, index: number, call: string) -> ()
  if value is not ModuleScript then
    error(
      `BadArgument: Bad argument #{index} for {call} (expected ModuleScript, got {typeof(value)})`,
      0
    )
  end
end

--- Errors unless a value is an array.
local function check_array(value: unknown, call: string) -> ()
  if value is not table then
    error(`BadArgument: Bad argument #1 for {call} (expected an array, got {typeof(value)})`, 0)
  end

  for key in value do
    if key is not number then
      error(
        `BadArgument: Bad argument #1 for {call} (expected an array, got a key of type {typeof(key)})`,
        0
      )
    end
  end
end

--- Errors unless a value is an Extension.
local function check_extension(value: unknown, index: number, call: string) -> ()
  const bad = `BadArgument: Bad argument #{index} for {call}`

  if value is not table then
    error(`{bad} (expected Extension, got {typeof(value)})`, 0)
  end

  if value.Name is not string then
    error(`{bad} (Name: expected string, got {typeof(value.Name)})`, 0)
  end

  for _, hook in [ 'onPhase', 'onProvider' ] do
    if value[hook] ~= nil and value[hook] is not function then
      error(`{bad} ({hook}: expected function or nil, got {typeof(value[hook])})`, 0)
    end
  end
end

--- Builds the entry of a provider from its module's value. Errors with
--- BadArgument when the value is no provider, or breaks its contract.
local function entry_of(module: ModuleScript, value: unknown) -> (Entry, unknown)
  const name = module.Name
  const provider = exported(value)

  if provider is not table then
    error(
      `BadArgument: {name} exports no provider (expected a struct instance, got {typeof(provider)})`,
      0
    )
  end

  const struct = getmetatable(provider)
  const options = options_of(struct)

  if options == nil then
    error(`BadArgument: {name} carries no @Provider; mark the struct of its default export`, 0)
  end

  check_contract(name, provider, options.lifecycles)

  for _, method in unlisted(provider, options.lifecycles) do
    warn(
      `Forge: {name} writes {method} but does not list it in @Provider, so Forge does not call it`
    )
  end

  const entry: Entry = {
    Name = name,
    ModuleScript = module,
    Provider = provider,
    Lifecycles = options.lifecycles,
    Priority = options.priority,
  }

  return entry, struct
end

--- Sorts entries by priority, higher first, in place. Ties keep the order
--- they were added in, since table.sort is not stable.
---
--- @within core
--- @private
--- @param entries -- The entries to sort
export function sort_by_priority(entries: { Entry }) -> ()
  local index_of: { [Entry]: number } = {}

  for index, entry in entries do
    index_of[entry] = index
  end

  table.sort(entries, function(a: Entry, b: Entry) -> boolean
    if a.Priority ~= b.Priority then
      return a.Priority > b.Priority
    end

    return index_of[a] < index_of[b]
  end)
end

--- Whether an entry lists a lifecycle.
local function lists(entry: Entry, method: string) -> boolean
  return table.find(entry.Lifecycles, method) ~= nil
end

--- Errors when a provider lists a lifecycle past Init and Start. Forge
--- asks while the lifecycles feature is off, since nothing would call
--- such a method.
local function check_boot_only(entry: Entry) -> ()
  for _, method in entry.Lifecycles do
    if not is_boot(method) then
      error(
        `MissingFeature: {entry.Name} lists '{method}', which needs the lifecycles feature of alloy/forge; turn it on in ember.toml`,
        0
      )
    end
  end
end

--- Whether this runs on the server. Forge asks for the boot summary, and
--- the lifecycles feature asks when a provider lists a lifecycle of one
--- side.
---
--- @within core
--- @private
--- @return boolean -- True on the server
export function on_server() -> boolean
  local server = false

  -- A statement, not a `@cfg` return, which unreachable_code misreads:
  -- Strata's docs/LANG_BUGS.md, entry 79.
  @cfg(server)
  server = true

  return server
end

impl Forge
  --- A new Forge.
  ---
  --- @param options -- The boot options. Nil gives the defaults.
  --- @return Forge -- The new Forge, with no providers
  --- @error string -- When `options` or `Verbose` has the wrong type (BadArgument)
  function new(options: Options?) -> Forge
    if options ~= nil and options is not table then
      error(
        `BadArgument: Bad argument #1 for new (expected Options or nil, got {typeof(options)})`,
        0
      )
    end

    const verbose = options?.Verbose

    if verbose ~= nil and verbose is not boolean then
      error(
        `BadArgument: Bad argument #1 for new (Verbose: expected boolean or nil, got {typeof(verbose)})`,
        0
      )
    end

    return new Forge { verbose = verbose ?? true }
  end

  --- Errors once the boot has begun.
  ---
  --- @method CheckIdle
  --- @within Forge
  --- @private
  --- @param call -- The name of the call, for the message
  private function CheckIdle(self, call: string) -> ()
    if self.started then
      error(`BadCall: Bad call for {call} (Forge has started)`, 0)
    end
  end

  --- Tells each extension that the boot reached a phase. The features
  --- hear it first, while the boot is still in the step before it, so the
  --- dependencies feature can load providers at PreInit.
  ---
  --- @method FirePhase
  --- @within Forge
  --- @private
  --- @param phase -- The phase the boot reached
  private function FirePhase(self, phase: Phase) -> ()
    for _, extension in hook.extensions do
      if const heard = extension.onPhase then
        heard(self, phase, self.entries)
      end
    end

    self.phase = phase

    for _, extension in self.extensions do
      if const heard = extension.onPhase then
        heard(self, phase, self.entries)
      end
    end
  end

  --- Tells each extension that one provider took a step.
  ---
  --- @method FireProvider
  --- @within Forge
  --- @private
  --- @param event -- The step the provider took
  --- @param entry -- The entry of the provider
  private function FireProvider(self, event: ProviderEvent, entry: Entry) -> ()
    for _, list in [ hook.extensions, self.extensions ] do
      for _, extension in list do
        if const heard = extension.onProvider then
          heard(self, event, entry)
        end
      end
    end
  end

  --- Adds a provider module. Adding one ModuleScript twice does nothing.
  ---
  --- @method AddProvider
  --- @within Forge
  --- @param module -- The ModuleScript of the provider
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When `module` is not a ModuleScript (BadArgument)
  function AddProvider(self, module: ModuleScript) -> Forge
    self:CheckIdle('AddProvider')
    check_module(module, 1, 'AddProvider')

    if not self.added:has(module) then
      self.added:add(module)
      table.insert(self.modules, module)
    end

    return self
  end

  --- Adds an array of provider modules, such as a folder's children.
  ---
  --- @method AddProviders
  --- @within Forge
  --- @param modules -- The ModuleScripts of the providers
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When `modules` is not an array of ModuleScripts (BadArgument)
  function AddProviders(self, modules: { Instance }) -> Forge
    self:CheckIdle('AddProviders')
    check_array(modules, 'AddProviders')

    for _, module in modules do
      self:AddProvider(module :: ModuleScript)
    end

    return self
  end

  --- Adds an extension.
  ---
  --- @method AddExtension
  --- @within Forge
  --- @param extension -- The extension to add
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When `extension` is not an [Extension] (BadArgument)
  function AddExtension(self, extension: Extension) -> Forge
    self:CheckIdle('AddExtension')
    check_extension(extension, 1, 'AddExtension')
    table.insert(self.extensions, extension)

    return self
  end

  --- Adds an array of extensions.
  ---
  --- @method AddExtensions
  --- @within Forge
  --- @param extensions -- The extensions to add
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When `extensions` is not an array of extensions (BadArgument)
  function AddExtensions(self, extensions: { Extension }) -> Forge
    self:CheckIdle('AddExtensions')
    check_array(extensions, 'AddExtensions')

    for _, extension in extensions do
      self:AddExtension(extension)
    end

    return self
  end

  --- Adds a lifecycle, such as `Forge.every(60, 'Autosave')`. A provider
  --- that lists its method gets its events. An extension may add one up to
  --- PreInit; Forge wires them all at PostInit. Two lifecycles may share a
  --- method, but one lifecycle added twice errors, since each copy would
  --- fire every handler again.
  ---
  --- @method AddLifecycle
  --- @within Forge
  --- @param lifecycle -- The lifecycle to add, such as one from [Forge.every]
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When the lifecycles feature is off (MissingFeature)
  --- @error string -- When Forge has wired the lifecycles (BadCall)
  --- @error string -- When `lifecycle` is not a lifecycle, or is added already (BadArgument)
  function AddLifecycle(self, lifecycle: CustomLifecycle) -> Forge
    served(hook.AddLifecycle, 'lifecycles', 'AddLifecycle')(self, lifecycle)

    return self
  end

  --- Adds an array of lifecycles.
  ---
  --- @method AddLifecycles
  --- @within Forge
  --- @param lifecycles -- The lifecycles to add
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When the lifecycles feature is off (MissingFeature)
  --- @error string -- When Forge has wired the lifecycles (BadCall)
  --- @error string -- When `lifecycles` is not an array of new lifecycles (BadArgument)
  function AddLifecycles(self, lifecycles: { CustomLifecycle }) -> Forge
    check_array(lifecycles, 'AddLifecycles')

    for _, lifecycle in lifecycles do
      self:AddLifecycle(lifecycle)
    end

    return self
  end

  --- Adds a trait module. Forge requires it now, so a bad trait fails
  --- here and not later as a tag that does nothing.
  ---
  --- @method AddTrait
  --- @within Forge
  --- @param module -- The ModuleScript of the trait
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When the traits feature is off (MissingFeature)
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When `module` is not a ModuleScript, or exports no `@Trait` (BadArgument)
  function AddTrait(self, module: ModuleScript) -> Forge
    const add = served(hook.AddTrait, 'traits', 'AddTrait')
    self:CheckIdle('AddTrait')
    check_module(module, 1, 'AddTrait')
    add(self, module)

    return self
  end

  --- Adds an array of trait modules, such as a folder's children.
  ---
  --- @method AddTraits
  --- @within Forge
  --- @param modules -- The ModuleScripts of the traits
  --- @return Forge -- The same Forge, for a chain of calls
  --- @error string -- When the traits feature is off (MissingFeature)
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When an item is not a ModuleScript, or exports no `@Trait` (BadArgument)
  function AddTraits(self, modules: { Instance }) -> Forge
    self:CheckIdle('AddTraits')
    check_array(modules, 'AddTraits')

    for _, module in modules do
      self:AddTrait(module :: ModuleScript)
    end

    return self
  end

  --- Loads one provider now and fires Loaded, or gives the entry of one
  --- loaded already. For extensions: it works during Load and PostLoad
  --- only. An entry loaded at PostLoad goes last, whatever its priority;
  --- reorder `entries` in onPhase when the order matters.
  ---
  --- @method LoadProvider
  --- @within Forge
  --- @param module -- The ModuleScript of the provider
  --- @return Entry -- The entry of the provider
  --- @error string -- When the boot is not at Load or PostLoad (BadCall)
  --- @error string -- When `module` holds no provider, or a second instance of one (BadArgument)
  --- @error string -- When it lists a lifecycle past Init and Start, and the lifecycles feature is off (MissingFeature)
  function LoadProvider(self, module: ModuleScript) -> Entry
    if self.phase ~= 'Load' and self.phase ~= Phase.PostLoad then
      error(
        'BadCall: Bad call for LoadProvider (Forge loads providers during Load and PostLoad only)',
        0
      )
    end

    check_module(module, 1, 'LoadProvider')

    if const loaded = self.by_module:get(module) then
      return loaded
    end

    const entry, struct = entry_of(module, import<<unknown>>(module))

    if hook.AddLifecycle == nil then
      check_boot_only(entry)
    end

    if self.structs:has(struct) then
      error(
        `BadArgument: {entry.Name} is a second instance of a provider struct; a provider is one instance`,
        0
      )
    end

    self.structs:add(struct)
    self.by_module:set(module, entry)
    table.insert(self.entries, entry)
    self:FireProvider(ProviderEvent.Loaded, entry)

    return entry
  end

  --- Runs every listed Init, in order. An Init that yields errors with
  --- NoYield.
  ---
  --- @method RunInit
  --- @within Forge
  --- @private
  private function RunInit(self) -> ()
    self.phase = 'Init'

    for _, entry in self.entries do
      if lists(entry, 'Init') then
        const ok, problem = run_sync(`{entry.Name}.Init`, entry.Provider.Init, entry.Provider)

        if not ok then
          error(problem, 0)
        end
      end

      self:FireProvider(ProviderEvent.Initialized, entry)
    end
  end

  --- Spawns every listed Start.
  ---
  --- @method RunStart
  --- @within Forge
  --- @private
  private function RunStart(self) -> ()
    self.phase = 'Start'

    for _, entry in self.entries do
      if lists(entry, 'Start') then
        task.spawn(entry.Provider.Start, entry.Provider)
      end

      self:FireProvider(ProviderEvent.Started, entry)
    end
  end

  --- Runs the boot. A second call errors.
  ---
  --- @method Start
  --- @within Forge
  --- @return Forge -- The same Forge
  --- @error string -- When Forge has started (BadCall)
  --- @error string -- When a provider lists a lifecycle of the other side (BadCall)
  --- @error string -- When a provider breaks its contract (BadArgument)
  --- @error string -- When a provider lists a lifecycle that nothing fires (BadArgument)
  --- @error string -- When a provider needs a feature that is off (MissingFeature)
  --- @error string -- When a `use` names a provider that Forge never loaded (MissingDependency)
  --- @error string -- When the uses form a cycle (CyclicDependency)
  --- @error string -- When a provider with a `use` field is frozen (FrozenModule)
  --- @error string -- When an Init yields (NoYield), or errors
  function Start(self) -> Forge
    if self.started then
      error('BadCall: Bad call for Start (Forge has started)', 0)
    end

    self.started = true
    const began = os.clock()

    self:FirePhase(Phase.PreLoad)
    self.phase = 'Load'

    for _, module in self.modules do
      self:LoadProvider(module)
    end

    sort_by_priority(self.entries)
    self:FirePhase(Phase.PostLoad)
    -- The dependencies feature loads, orders and fills the uses here.
    self:FirePhase(Phase.PreInit)
    self:RunInit()
    -- The lifecycles feature wires the lifecycles here.
    self:FirePhase(Phase.PostInit)
    self:FirePhase(Phase.PreStart)
    self:RunStart()
    -- The traits feature starts to watch the tags here.
    self:FirePhase(Phase.PostStart)

    if self.verbose then
      const side = on_server() ? 'Server' : 'Client'
      const ms = math.round((os.clock() - began) * 1000)
      print(`Forge ({side}) started {#self.entries} providers in {ms}ms`)
    end

    return self
  end

  --- A lifecycle that calls `method(self, dt)` about every `seconds`. Add
  --- it with [Forge:AddLifecycle].
  ---
  --- @param seconds -- The time between two calls
  --- @param method -- The method name that a provider lists and writes
  --- @return CustomLifecycle -- The new lifecycle
  --- @error string -- When the lifecycles feature is off (MissingFeature)
  --- @error string -- When `seconds` is not positive, or `method` is empty (BadArgument)
  function every(seconds: number, method: string) -> CustomLifecycle
    return served(hook.every, 'lifecycles', 'Forge.every')(seconds, method)
  end

  --- Declares a dependency: put it in a provider field, and Forge puts the
  --- provider it names there before any Init. A name finds a provider the
  --- game added; a ModuleScript loads one no one added.
  ---
  ---     data: DataProvider = Forge.use('DataProvider')
  ---
  --- @param target -- The provider name, or its ModuleScript
  --- @return any -- A marker that Forge replaces with the provider
  --- @error string -- When the dependencies feature is off (MissingFeature)
  --- @error string -- When `target` is an empty name or no ModuleScript (BadArgument)
  @allow(explicit_any)
  function use(target: string | ModuleScript) -> any
    return served(hook.use, 'dependencies', 'Forge.use')(target)
  end

  --- The object a trait has bound to an instance, or nil:
  --- `Forge.trait<<Door>>(part, Door)`.
  ---
  --- @param instance -- The tagged instance
  --- @param trait -- The trait struct, or the value of its module
  --- @return T? -- The bound object, or nil when the trait has not bound to `instance`
  --- @error string -- When the traits feature is off (MissingFeature)
  function trait<T>(instance: Instance, trait: unknown) -> T?
    return served(hook.trait, 'traits', 'Forge.trait')(instance, trait) :: T?
  end

  --- Every object a trait has bound: `Forge.traits<<Door>>(Door)`.
  ---
  --- @param trait -- The trait struct, or the value of its module
  --- @return { T } -- The bound objects, in no set order
  --- @error string -- When the traits feature is off (MissingFeature)
  function traits<T>(trait: unknown) -> { T }
    return (served(hook.traits, 'traits', 'Forge.traits')(trait) :: unknown) :: { T }
  end
end

--- The tests of the core, with the fixture providers they load. The ship
--- artifact leaves the whole group out.
@test
namespace CoreTests
  --- A provider in the form to write: `@Provider` on the impl, by key.
  private struct Keyed
    saves: number = 0
  end

  @Provider({ lifecycles = [ Lifecycle.Init, 'Autosave' ], priority = 10 })
  impl Keyed
    private function Init(self) -> ()
      self.saves = 0
    end

    private function Autosave(self) -> ()
      self.saves += 1
    end
  end

  --- A provider with `@Provider` on the struct, by position.
  @Provider([ Lifecycle.PlayerAdded ], 3)
  private struct Positional
    greeted: number = 0
  end

  impl Positional
    private function PlayerAdded(self, _player: Player) -> ()
      self.greeted += 1
    end
  end

  --- A provider with no options at all.
  @Provider()
  private struct Plain
    x: number = 0
  end

  --- A provider that lists Start and writes no Start method.
  private struct Broken
    x: number = 0
  end

  --@alloy-expect-error the contract asks the impl for a private Start
  @Provider({ lifecycles = [ Lifecycle.Start ] })
  impl Broken
  end

  --- A ModuleScript named for a test.
  private function module(name: string) -> ModuleScript
    return new Instance('ModuleScript') { Name = name }
  end

  --- An entry with a priority, for the sort.
  private function ranked(name: string, priority: number) -> Entry
    return {
      Name = name,
      ModuleScript = module(name),
      Provider = {},
      Lifecycles = [],
      Priority = priority,
    }
  end

  --- A Forge that prints nothing.
  private function quiet() -> Forge
    return new Forge({ Verbose = false })
  end

  --- Sorts by priority, and keeps ties in the order they came.
  public function sorts_by_priority_and_keeps_ties() -> ()
    const entries = [ ranked('A', 0), ranked('B', 5), ranked('C', 0), ranked('D', 5) ]
    sort_by_priority(entries)

    const names = entries:map(function(entry: Entry) -> string
      return entry.Name
    end)

    $assert_eq(names:join(','), 'B,D,A,C')
  end

  --- Reads `@Provider` from an impl, by key.
  public function reads_the_options_of_an_impl() -> ()
    const entry = entry_of(module('KeyedProvider'), { default = new Keyed {} })

    $assert_eq(entry.Name, 'KeyedProvider')
    $assert_eq(entry.Priority, 10)
    $assert_eq(table.concat(entry.Lifecycles, ','), 'Init,Autosave')
  end

  --- Reads `@Provider` from a struct, by position.
  public function reads_the_options_of_a_struct() -> ()
    const entry = entry_of(module('PositionalProvider'), { default = new Positional {} })

    $assert_eq(entry.Priority, 3)
    $assert_eq(table.concat(entry.Lifecycles, ','), 'PlayerAdded')
  end

  --- Reads an empty @Provider().
  public function reads_empty_options() -> ()
    const entry = entry_of(module('PlainProvider'), { default = new Plain {} })

    $assert_eq(entry.Priority, 0)
    $assert_eq(#entry.Lifecycles, 0)
  end

  --- Refuses a value with no @Provider.
  public function refuses_a_value_with_no_provider() -> ()
    $expect(function() -> ()
      entry_of(module('Nothing'), { default = {} })
    end):toThrow('BadArgument')
  end

  --- Refuses a provider that breaks its contract, as the compiler does.
  public function refuses_a_broken_contract() -> ()
    $expect(function() -> ()
      entry_of(module('Broken'), { default = new Broken {} })
    end):toThrow('BadArgument: Broken lists \'Start\'')
  end

  --- Fires the phases in order.
  public function fires_the_phases_in_order() -> ()
    const heard: { string } = {}
    const forge = quiet():AddExtension({
      Name = 'Recorder',
      onPhase = function(_forge: Forge, phase: Phase, _entries: { Entry }) -> ()
        table.insert(heard, phase)
      end,
    })

    forge:Start()

    $assert_eq(table.concat(heard, ','), 'PreLoad,PostLoad,PreInit,PostInit,PreStart,PostStart')
  end

  --- Errors on a second Start.
  public function refuses_a_second_start() -> ()
    const forge = quiet():Start()

    $expect(function() -> ()
      forge:Start()
    end):toThrow('BadCall')
  end

  --- Errors on an add after Start.
  public function refuses_an_add_after_start() -> ()
    const forge = quiet():Start()

    $expect(function() -> ()
      forge:AddProvider(module('Late'))
    end):toThrow('BadCall')
  end

  --- Errors on an add of something that is no ModuleScript.
  public function refuses_a_provider_that_is_no_module() -> ()
    $expect(function() -> ()
      quiet():AddProvider((new Instance('Folder') :: unknown) :: ModuleScript)
    end):toThrow('BadArgument')
  end

  --- Ignores a second add of one ModuleScript.
  public function ignores_a_second_add() -> ()
    const shared = module('Shared')

    quiet():AddProvider(shared):AddProvider(shared)
  end

  --- Errors on LoadProvider outside the load window.
  public function refuses_a_load_outside_the_window() -> ()
    $expect(function() -> ()
      quiet():LoadProvider(module('Early'))
    end):toThrow('BadCall')
  end

  --- With no feature loaded, the core boots on its own: every phase
  --- fires, and the hook holds no feature.
  public function the_core_boots_alone() -> ()
    const heard: { string } = {}

    quiet()
      :AddExtension({
        Name = 'Recorder',
        onPhase = function(_forge: Forge, phase: Phase, _entries: { Entry }) -> ()
        table.insert(heard, phase)
      end,
      })
      :Start()

    $assert_eq(#hook.extensions, 0)
    $assert_eq(hook.AddLifecycle, nil)
    $assert_eq(hook.use, nil)
    $assert_eq(hook.AddTrait, nil)
    $assert_eq(#heard, 6)
  end

  --- With no feature loaded, each Forge method of a feature names the
  --- feature it needs.
  public function a_method_of_a_feature_that_is_off_names_it() -> ()
    $expect(function() -> ()
      Forge.every(1, 'Tick')
    end):toThrow('MissingFeature: Forge.every needs the lifecycles feature')
    $expect(function() -> ()
      quiet():AddLifecycle({ Method = 'Tick', Connect = function(_fire) -> RBXScriptConnection?
        return nil
      end })
    end):toThrow('MissingFeature: AddLifecycle needs the lifecycles feature')
    $expect(function() -> ()
      Forge.use('Data')
    end):toThrow('MissingFeature: Forge.use needs the dependencies feature')
    $expect(function() -> ()
      quiet():AddTrait(module('Door'))
    end):toThrow('MissingFeature: AddTrait needs the traits feature')
    $expect(function() -> ()
      Forge.trait(module('Door'), {})
    end):toThrow('MissingFeature: Forge.trait needs the traits feature')
    $expect(function() -> ()
      Forge.traits({})
    end):toThrow('MissingFeature: Forge.traits needs the traits feature')
  end

  --- With the lifecycles feature off, a provider may list Init and Start
  --- only.
  public function a_lifecycle_past_start_needs_the_lifecycles_feature() -> ()
    check_boot_only(entry_of(module('Plain'), { default = new Plain {} }))
    $expect(function() -> ()
      check_boot_only(entry_of(module('Keyed'), { default = new Keyed {} }))
    end):toThrow('MissingFeature: Keyed lists \'Autosave\'')
  end

  --- A feature hears each phase before the game's extensions do.
  public function a_feature_hears_each_phase_first() -> ()
    const heard: { string } = {}
    const feature: Extension = {
      Name = 'Feature',
      onPhase = function(_forge: Forge, phase: Phase, _entries: { Entry }) -> ()
        table.insert(heard, `feature {phase}`)
      end,
    }

    table.insert(hook.extensions, feature)
    const forge = quiet():AddExtension({
      Name = 'Game',
      onPhase = function(_forge: Forge, phase: Phase, _entries: { Entry }) -> ()
        table.insert(heard, `game {phase}`)
      end,
    })
    const ran = Result.pcall(function() -> ()
      forge:Start()
    end)
    table.remove(hook.extensions, table.find(hook.extensions, feature) :: number)

    if local Err(problem) = ran then
      error(problem, 0)
    end

    $assert_eq(heard[1], 'feature PreLoad')
    $assert_eq(heard[2], 'game PreLoad')
    $assert_eq(#heard, 12)
  end
end
