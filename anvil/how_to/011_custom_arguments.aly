--[[
  Argument types of the game's own. A struct marked `@argument` is an
  argument type: a parameter of that type takes one word, and Anvil
  calls the struct's static `parse` with the word and the caller. The
  attribute's contract asks for that `parse`, so the compiler reports a
  struct that has none.

  `parse` gives the value, or nil for a word that is not one; nil gives
  the usual error, with the text of `@argument`. It can also `fail` with
  a reason of its own.
]]

import { argument, command, fail, on } from '@packages/anvil'

--- The colors a word can name.
const NAMED: { [string]: Color3 } = {
  red = new Color3(1, 0.2, 0.2),
  green = new Color3(0.2, 0.8, 0.2),
  blue = new Color3(0.2, 0.4, 1),
  white = new Color3(1, 1, 1),
  black = new Color3(0.1, 0.1, 0.1),
}

--- A color: a name, or a hex code.
@argument('a color: red, green, blue, white, black, or a hex code such as #ff8800')
struct Paint
  color: Color3
end

impl Paint
  --- The color a word names.
  function parse(text: string, _caller: Player) -> Paint?
    if const named = NAMED[string.lower(text)] then
      return new Paint { color = named }
    elseif string.sub(text, 1, 1) ~= '#' then
      return nil
    end

    match Result.pcall(Color3.fromHex, text) with
      case Ok(color) then
        return new Paint { color = color }
      case Err(_) then
        return fail(`"{text}" is no hex code. Write six digits after the #, such as #ff8800.`)
    end
  end
end

--- Paints a character.
@command(0, 'Paints the character of a player.')
remote function Color(target: Player, paint: Paint) -> string from client

-- The handler gets the struct that `parse` gave.
on(Color)(function(_, target, paint)
  const character = target.Character ?? fail(`{target.Name} has no character.`)

  for _, part in character:GetDescendants() where part is BasePart do
    part.Color = paint.color
  end

  return `{target.Name} is {paint.color:ToHex()} now.`
end)

--[[
    color me red        Builderman is ff3333 now.
    color me #00ff00    Builderman is 00ff00 now.
    color me #zz        "#zz" is no hex code. Write six digits after the #, such as #ff8800.
    color me pink       paint wants a color: red, green, blue, white, black, or a hex code such as #ff8800, but got "pink".

  The rules:

  - The contract reads `function parse(text: string, caller: Player)`.
    The return type is free: the struct, or nil.
  - The struct must be data that a remote can carry, since the
    declaration is a remote.
  - `caller` lets a word such as `here` read the caller.
]]
