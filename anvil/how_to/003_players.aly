--[[
  Players as arguments. A `Player` parameter takes one player of the
  server, and a `{ Player }` parameter takes a list of them. Anvil reads
  the word, finds the players, and hands the handler the Player
  instances.

    Player       me, a name, the start of a name, or a display name
    { Player }   the same, or all, or others, with commas between
]]

import { command, on } from '@packages/anvil'

--- Waves at one player.
@command(0, 'Waves at a player.')
remote function Wave(target: Player) -> string from client

--- Puts sparkles on some players.
@command(0, 'Puts sparkles on players.')
remote function Sparkle(targets: { Player }) -> string from client

on(Wave)(function(caller, target)
  return target == caller ? 'You wave at yourself.' : `{caller.Name} waves at {target.Name}.`
end)

on(Sparkle)(function(_, targets)
  const names: { string } = []

  for _, target in targets do
    if const root = target.Character->HumanoidRootPart then
      new Instance('Sparkles') { Parent = root }
      table.insert(names, target.Name)
    end
  end

  return `Sparkles on {table.concat(names, ', ')}.`
end)

--[[
  With Builderman, Shedletsky, and StickMasterLuke in the server:

    wave shedletsky     the name, in any case
    wave stick          the start of a name: StickMasterLuke
    wave Bob            a display name
    wave s              s could be Shedletsky, StickMasterLuke. Write more of the name.
    sparkle all         all three
    sparkle others      everyone but the caller
    sparkle me,shed     the caller and Shedletsky

  The rules:

  - An exact name wins over an exact display name, and both win over the
    start of a name. A player picks a display name, so it can copy
    another player's name.
  - `all` and `others` fit a `{ Player }` alone. A `Player` wants one.
  - A list holds each player once, and a word that names no one fails.
]]
