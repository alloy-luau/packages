--[[
  Spawn commands for the developer. The owner of the place is the
  developer, and so is each player in a Studio test.
]]

import RunService from '@game/RunService'
import { serve } from '@packages/anvil'
import { DEVELOPER } from './commands'

serve(function(player)
  return (player.UserId == game.CreatorId or RunService:IsStudio()) ? DEVELOPER : 0
end)
