--[[
  Systems and the scheduler. A system is a named function that takes the
  world and the seconds since the last frame. `system` names its phase,
  at the end of the system's module:

    function movement(world: World, dt: number) -> ()
      ...
    end

    export default system(movement, Phase.Simulation)

  The scheduler runs each phase on its RunService event:

    Startup         once, before the first frame
    PreSimulation   RunService.PreSimulation, before Roblox's physics
    Simulation      RunService.PostSimulation, after the physics
    PostSimulation  RunService.PostSimulation, after Simulation
    Render          RunService.PreRender, on a client only

  A game adds phases of its own, from an enum that it declares:

    enum GamePhase
      Input
      Autosave
    end

    scheduler:before(Phase.PreSimulation, GamePhase.Input)
    scheduler:on(autosave_timer.Event, GamePhase.Autosave)

  `before` and `after` put a phase beside one that the scheduler has, on
  the same event. `on` gives a phase an event of its own. A unit variant
  of an enum is its name, so a phase is a string, and each phase of one
  scheduler has its own name.

  Inside a phase, the systems run in the order the scheduler got them.
  `step` runs one frame by hand, so a test needs no RunService.

  An attribute, `@system(Phase.Simulation)`, would read better. Alloy
  keeps a function's attributes in the runtime copy of the module that
  declares the function, and a package has a runtime copy of its own,
  so Lattice could not read them. `system` keeps the phase here instead.
]]

--- @class scheduler
--- Systems and their phases. [scheduler.system] names the phase of a
--- system, and a [Scheduler] runs the systems of a world.
--- Import these from `@packages/lattice`.

import RunService from '@game/RunService'
import type { World } from './world'

--- @type Phase 'Startup' | 'PreSimulation' | 'Simulation' | 'PostSimulation' | 'Render'
--- @within scheduler
--- The built-in phases of a frame. A system that [scheduler.system] does
--- not name runs in Simulation. A [Scheduler] runs each phase on its
--- RunService event:
---
--- - `Phase.Startup`: once, before the first frame
--- - `Phase.PreSimulation`: on `RunService.PreSimulation`, before the physics
--- - `Phase.Simulation`: on `RunService.PostSimulation`, after the physics
--- - `Phase.PostSimulation`: on `RunService.PostSimulation`, after Simulation
--- - `Phase.Render`: on `RunService.PreRender`, on a client only
---
--- A game adds its own phases with [Scheduler:before], [Scheduler:after],
--- and [Scheduler:on]. A phase is the name of an enum variant, so a
--- variant of the game's own unit enum is a phase too.
export enum Phase
  Startup
  PreSimulation
  Simulation
  PostSimulation
  Render
end

--- @within scheduler
--- A system: it reads and writes the world, and `dt` is the seconds
--- since the last frame. A Startup system gets 0.
export type System = (world: World, dt: number) -> ()

-- The phase that `system` named for each system. Weak keys: a system
-- that goes takes its phase with it.
local named: { [System]: string } = setmetatable({}, { __mode = 'k' })

--- Names the phase of a system, and gives the system back, so a system
--- module ends with `export default system(movement, Phase.Simulation)`.
--- The phase is a variant of [Phase], or of an enum of the game. A
--- second call with another phase stops with an error.
--- @within scheduler
--- @param run -- The system
--- @param phase -- The phase that the system runs in
--- @return System -- The same system
--- @error string -- When an earlier call gave the system another phase
export function system(run: System, phase: string) -> System
  const had = named[run]
  assert(had == nil or had == phase, `lattice: this system runs in {had} already`)
  named[run] = phase
  return run
end

-- A system's name for a warning: its function name, or its place.
local function name_of(run: System) -> string
  const name = debug.info(run, 'n')
  return (name == nil or name == '') ? tostring(run) : name
end

--- @class Scheduler
--- Runs the systems of one world, phase by phase.
export struct Scheduler
  --- @prop world World
  --- @within Scheduler
  --- @readonly
  --- The world that each system gets.
  read world: World
  -- Each phase, in the order that `step` runs them.
  private order: { string } = {}
  -- The systems of each phase, in the order they run.
  private systems: { [string]: { System } } = {}
  -- The phases that run one time, when the scheduler starts.
  private once: { [string]: boolean } = {}
  -- The event of each phase that runs each frame. A phase with none
  -- runs by hand only, as Render does on the server.
  private events: { [string]: RBXScriptSignal } = {}
  -- Each system that the scheduler holds, so a second add keeps its place.
  private known: { [System]: boolean } = {}
  -- Whether the Startup phases ran.
  private started: boolean = false
  private connections: { RBXScriptConnection } = {}
end

impl Scheduler
  --- A scheduler for `world`, with the built-in phases and no systems.
  --- @param world -- The world that each system gets
  --- @return Scheduler -- The new scheduler
  function new(world: World) -> Scheduler
    const scheduler = new Scheduler { world = world }

    scheduler:insert(Phase.Startup, 1)
    scheduler.once[Phase.Startup] = true
    scheduler:on(RunService.PreSimulation, Phase.PreSimulation)
    scheduler:on(RunService.PostSimulation, Phase.Simulation, Phase.PostSimulation)
    scheduler:insert(Phase.Render, #scheduler.order + 1)

    @cfg(client)
    scheduler.events[Phase.Render] = RunService.PreRender

    return scheduler
  end

  --- Adds phases that run before `anchor`, on the same event, in the
  --- order the call gives them. A phase before Startup runs one time.
  --- @method before
  --- @within Scheduler
  --- @param anchor -- A phase that the scheduler has
  --- @param ... -- The new phases, such as the variants of an enum of the game
  --- @return Scheduler -- The same scheduler, so the calls can chain
  --- @error string -- When the scheduler has no `anchor`, has a new phase already, or runs
  function before(self, anchor: string, ...: string) -> Scheduler
    return self:beside(anchor, false, { ... })
  end

  --- Adds phases that run after `anchor`, on the same event, in the
  --- order the call gives them. A phase after Startup runs one time.
  --- @method after
  --- @within Scheduler
  --- @param anchor -- A phase that the scheduler has
  --- @param ... -- The new phases, such as the variants of an enum of the game
  --- @return Scheduler -- The same scheduler, so the calls can chain
  --- @error string -- When the scheduler has no `anchor`, has a new phase already, or runs
  function after(self, anchor: string, ...: string) -> Scheduler
    return self:beside(anchor, true, { ... })
  end

  --- Adds phases that run each time `event` fires, in the order the
  --- call gives them. Each system gets the first argument of the event
  --- as `dt` when that is a number, as with `RunService.Heartbeat`, and
  --- 0 when it is not. `step` runs these phases after the phases that
  --- the scheduler has.
  --- @method on
  --- @within Scheduler
  --- @param event -- The event that runs the phases
  --- @param ... -- The new phases, such as the variants of an enum of the game
  --- @return Scheduler -- The same scheduler, so the calls can chain
  --- @error string -- When the scheduler has a new phase already, or runs
  function on(self, event: RBXScriptSignal, ...: string) -> Scheduler
    for _, phase in { ... } do
      self:insert(phase, #self.order + 1)
      self.events[phase] = event
    end

    return self
  end

  --- Adds systems. Each one goes to the phase that `system` named for
  --- it. A system that the scheduler holds keeps its first place, so a
  --- caller can add the systems that must run first, then the rest.
  --- @method add
  --- @within Scheduler
  --- @param ... -- The systems to add
  --- @return Scheduler -- The same scheduler, so the calls can chain
  --- @error string -- When the scheduler does not have the phase of a system
  function add(self, ...: System) -> Scheduler
    for _, run in { ... } do
      if not self.known[run] then
        self.known[run] = true
        table.insert(self:systems_of(named[run] ?? Phase.Simulation), run)
      end
    end

    return self
  end

  --- Runs the systems of one phase by hand. An error stops the run and
  --- goes to the caller, as a test wants.
  --- @method run
  --- @within Scheduler
  --- @param phase -- The phase to run
  --- @param dt -- The seconds that each system gets. The default is 0
  --- @error string -- When the scheduler does not have the phase
  function run(self, phase: string, dt: number = 0) -> ()
    for _, run in self:systems_of(phase) do
      run(self.world, dt)
    end
  end

  --- Runs one frame by hand: the Startup phases on the first call, then
  --- each other phase in order, with the phases of the game in their
  --- places.
  --- @method step
  --- @within Scheduler
  --- @param dt -- The seconds that each system gets. The default is 1/60
  function step(self, dt: number = 1 / 60) -> ()
    self:startup()

    for _, phase in self.order where not self.once[phase] do
      self:run(phase, dt)
    end
  end

  --- Runs the Startup phases, then each phase on its event. An error in
  --- a system shows as a warning with the system's name, and the next
  --- system runs.
  --- @method start
  --- @within Scheduler
  --- @error string -- When the scheduler runs already
  function start(self) -> ()
    assert(#self.connections == 0, 'lattice: this scheduler runs already')

    self:startup()

    -- One connection for each event, so the phases of an event run in
    -- their order.
    local groups: { [RBXScriptSignal]: { string } } = {}

    for _, phase in self.order do
      const event = self.events[phase]

      if event == nil then
        continue
      end

      local group = groups[event]

      if group == nil then
        const made: { string } = {}
        group = made
        groups[event] = made

        table.insert(self.connections, event:Connect(function(dt: unknown) -> ()
          for _, each in made do
            self:guarded(each, dt is number ? dt : 0)
          end
        end))
      end

      table.insert(group, phase)
    end
  end

  --- Stops the events of the phases. `start` runs them again, with no
  --- second Startup.
  --- @method stop
  --- @within Scheduler
  function stop(self) -> ()
    for _, connection in self.connections do
      connection:Disconnect()
    end

    table.clear(self.connections)
  end

  -- Puts a new phase at `index` of the order, with no systems.
  private function insert(self, phase: string, index: number) -> ()
    assert(#self.connections == 0, 'lattice: add each phase before start()')
    assert(self.systems[phase] == nil, `lattice: this scheduler has the phase {phase} already`)
    table.insert(self.order, index, phase)
    self.systems[phase] = {}
  end

  -- Puts each new phase beside `anchor`, with the event of `anchor`.
  private function beside(self, anchor: string, after: boolean, phases: { string }) -> Scheduler
    self:systems_of(anchor)

    for place, phase in phases do
      -- A phase before the anchor moves the anchor one place on, so the
      -- anchor's own index is the place of the next one.
      self:insert(phase, (table.find(self.order, anchor) :: number) + (after ? place : 0))
      self.once[phase] = self.once[anchor]
      self.events[phase] = self.events[anchor]
    end

    return self
  end

  -- The systems of a phase. A phase that the scheduler does not have
  -- stops with an error.
  private function systems_of(self, phase: string) -> { System }
    return self.systems[phase]
      ?? error(`lattice: this scheduler has no phase {phase}; add it with before, after, or on`, 3)
  end

  -- Runs each phase that runs one time, on the first call.
  private function startup(self) -> ()
    if not self.started then
      self.started = true

      for _, phase in self.order where self.once[phase] do
        self:run(phase)
      end
    end
  end

  -- Runs one phase. A system that fails cannot stop the systems after it.
  private function guarded(self, phase: string, dt: number) -> ()
    for _, run in self.systems[phase] do
      const result = Result.pcall(run, self.world, dt)

      if local Err(message) = result then
        warn(`lattice: the system {name_of(run)} failed: {result.trace ?? message}`)
      end
    end
  end
end

@test
namespace SchedulerTests
  import { world as new_world } from './world'

  -- The phases of a game: a unit enum of its own.
  enum GamePhase
    Setup
    Network
    Input
    Combat
    Cleanup
    Autosave
  end

  -- The order the systems below ran in, by name.
  const ran: { string } = {}

  private function spawn(_world: World, dt: number) -> ()
    table.insert(ran, `spawn {dt}`)
  end

  private function input(_world: World, _dt: number) -> ()
    table.insert(ran, 'input')
  end

  -- `system` does not name this one, so it runs in Simulation.
  private function movement(_world: World, _dt: number) -> ()
    table.insert(ran, 'movement')
  end

  private function damage(_world: World, _dt: number) -> ()
    table.insert(ran, 'damage')
  end

  private function cleanup(_world: World, _dt: number) -> ()
    table.insert(ran, 'cleanup')
  end

  private function draw(_world: World, dt: number) -> ()
    table.insert(ran, `draw {dt}`)
  end

  private function broken(_world: World, _dt: number) -> ()
    error('boom')
  end

  -- A scheduler with each system above, added out of order.
  private function make() -> Scheduler
    table.clear(ran)
    system(spawn, Phase.Startup)
    system(input, Phase.PreSimulation)
    system(damage, Phase.Simulation)
    system(cleanup, Phase.PostSimulation)
    system(draw, Phase.Render)
    return new Scheduler(new_world()):add(draw, cleanup, movement, damage, input, spawn)
  end

  --- A step runs Startup once, then the phases in frame order.
  public function step_runs_the_phases_in_order() -> ()
    const scheduler = make()
    scheduler:step(0.5)
    scheduler:step(0.5)

    $assert_eq(
      table.concat(ran, ', '),
      'spawn 0, input, movement, damage, cleanup, draw 0.5, input, movement, damage, cleanup, draw 0.5'
    )
  end

  --- system gives the system back, and refuses a second phase.
  public function system_names_one_phase() -> ()
    $assert_eq(system(input, Phase.PreSimulation), input)

    $expect(function() -> ()
      system(input, Phase.Render)
    end):toThrow('runs in PreSimulation already')
  end

  --- run runs one phase, and each system gets the world.
  public function run_runs_one_phase_with_the_world() -> ()
    const w = new_world()
    local got: World? = nil
    const scheduler = new Scheduler(w):add(function(given: World, _dt: number) got = given end)

    scheduler:run(Phase.Simulation)
    $assert_eq(got, w)
  end

  --- start runs Startup, then each phase on its event. A system that
  --- fails warns, and the next one runs. stop ends the events.
  @allow(explicit_any)
  public function start_runs_the_phases_on_their_events() -> ()
    -- The test shim has no frame events and no IsClient, so the test
    -- gives RunService its own. A write to a service goes through `any`.
    const pre = new Instance('BindableEvent')
    const post = new Instance('BindableEvent')
    const render = new Instance('BindableEvent')
    local service: any = RunService
    service.PreSimulation = pre.Event
    service.PostSimulation = post.Event
    service.PreRender = render.Event
    service.IsClient = function() return true end

    make()
    const scheduler = new Scheduler(new_world()):add(spawn, broken, movement, cleanup, input, draw)
    scheduler:start()
    pre:Fire(0.1)
    post:Fire(0.1)
    render:Fire(0.1)

    $expect(function() -> ()
      scheduler:start()
    end):toThrow('runs already')

    scheduler:stop()
    post:Fire(0.1)
    scheduler:start()
    post:Fire(0.1)
    scheduler:stop()

    $assert_eq(
      table.concat(ran, ', '),
      'spawn 0, input, movement, cleanup, draw 0.1, movement, cleanup'
    )
  end

  --- A second add of a system keeps its first place.
  public function a_second_add_keeps_the_first_place() -> ()
    const scheduler = make():add(input)
    scheduler:run(Phase.PreSimulation)

    $assert_eq(#ran, 1)
  end

  -- A system that writes its name, in `phase`.
  private function marks(name: string, phase: string) -> System
    return system(function(_world: World, _dt: number) -> ()
      table.insert(ran, name)
    end, phase)
  end

  --- A phase of the game runs beside its anchor, in the order of the call.
  public function a_game_phase_runs_beside_its_anchor() -> ()
    table.clear(ran)

    const scheduler = new Scheduler(new_world())
      :before(Phase.PreSimulation, GamePhase.Input)
      :after(Phase.Simulation, GamePhase.Combat, GamePhase.Cleanup)
      :before(GamePhase.Input, GamePhase.Network)
      :after(Phase.Startup, GamePhase.Setup)
      :add(
        marks('cleanup', GamePhase.Cleanup),
        marks('late', Phase.PostSimulation),
        marks('combat', GamePhase.Combat),
        marks('move', Phase.Simulation),
        marks('early', Phase.PreSimulation),
        marks('input', GamePhase.Input),
        marks('network', GamePhase.Network),
        marks('setup', GamePhase.Setup),
        marks('spawn', Phase.Startup)
      )

    scheduler:step()
    scheduler:step()

    $assert_eq(
      table.concat(ran, ', '),
      'spawn, setup, network, input, early, move, combat, cleanup, late, '
        .. 'network, input, early, move, combat, cleanup, late'
    )
  end

  --- A phase beside an anchor runs on the event of the anchor, and a
  --- phase that `on` adds runs on its own event.
  @allow(explicit_any)
  public function a_game_phase_runs_on_its_event() -> ()
    -- The test shim has no frame events, so the test gives RunService
    -- its own. A write to a service goes through `any`.
    const pre = new Instance('BindableEvent')
    const post = new Instance('BindableEvent')
    const timer = new Instance('BindableEvent')
    local service: any = RunService
    service.PreSimulation = pre.Event
    service.PostSimulation = post.Event
    table.clear(ran)

    const scheduler = new Scheduler(new_world())
      :before(Phase.PreSimulation, GamePhase.Input)
      :after(Phase.PostSimulation, GamePhase.Cleanup)
      :on(timer.Event, GamePhase.Autosave)
      :add(
        marks('early', Phase.PreSimulation),
        marks('input', GamePhase.Input),
        marks('cleanup', GamePhase.Cleanup),
        system(function(_world: World, dt: number) -> ()
        table.insert(ran, `autosave {dt}`)
      end, GamePhase.Autosave)
      )

    scheduler:start()
    pre:Fire(0.1)
    $assert_eq(table.concat(ran, ', '), 'input, early')

    post:Fire(0.1)
    timer:Fire(60)
    timer:Fire('not a number')
    scheduler:stop()
    timer:Fire(60)

    $assert_eq(table.concat(ran, ', '), 'input, early, cleanup, autosave 60, autosave 0')

    -- `step` runs a phase with its own event too, after the others.
    table.clear(ran)
    scheduler:step(0.5)
    $assert_eq(table.concat(ran, ', '), 'input, early, cleanup, autosave 0.5')
  end

  --- A phase needs an anchor that the scheduler has, a new name, and a
  --- scheduler that does not run. A system needs a phase that it has.
  public function a_wrong_phase_stops() -> ()
    const scheduler = new Scheduler(new_world()):after(Phase.Simulation, GamePhase.Combat)

    $expect(function() -> ()
      scheduler:before(GamePhase.Input, GamePhase.Network)
    end):toThrow('has no phase Input')

    $expect(function() -> ()
      scheduler:after(Phase.Startup, GamePhase.Combat)
    end):toThrow('has the phase Combat already')

    $expect(function() -> ()
      scheduler:add(marks('input', GamePhase.Input))
    end):toThrow('has no phase Input')

    $expect(function() -> ()
      scheduler:run(GamePhase.Input)
    end):toThrow('has no phase Input')

    scheduler:start()

    $expect(function() -> ()
      scheduler:before(Phase.Simulation, GamePhase.Input)
    end):toThrow('before start()')

    scheduler:stop()
  end

  --- In a run by hand, an error goes to the caller.
  public function an_error_in_run_goes_to_the_caller() -> ()
    const scheduler = new Scheduler(new_world()):add(function(_world: World, _dt: number)
      error('boom')
    end)

    $expect(function() -> ()
      scheduler:step()
    end):toThrow('boom')
  end
end
